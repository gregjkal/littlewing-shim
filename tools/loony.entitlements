<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Unicorn translates the game's PowerPC code into native code at run time. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Signed ad hoc, the bundled libraries have no team ID to match the
	     app's, so the hardened runtime would refuse to load them. (Signed
	     with a Developer ID, they match and this does nothing.) -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
