diff --git a/include/uc_priv.h b/include/uc_priv.h
index bd72b7950c..7d5162ee36 100644
--- a/include/uc_priv.h
+++ b/include/uc_priv.h
@@ -145,6 +145,12 @@ typedef void (*uc_softfloat_initialize)(void);
 // tcg flush softmmu tlb
 typedef void (*uc_tcg_flush_tlb)(struct uc_struct *uc);
 
+// Set TLB_NOTDIRTY again on the softmmu tlb entries writing to
+// [start, start + len) of the RAM region mr
+typedef void (*uc_tcg_reset_dirty_tlb_t)(struct uc_struct *uc,
+                                         MemoryRegion *mr, uint64_t start,
+                                         uint64_t len);
+
 // Invalidate the TB at given address
 typedef void (*uc_invalidate_tb_t)(struct uc_struct *uc, uint64_t start,
                                    size_t len);
@@ -314,6 +320,7 @@ struct uc_struct {
     uc_target_page_init target_page;
     uc_softfloat_initialize softfloat_initialize;
     uc_tcg_flush_tlb tcg_flush_tlb;
+    uc_tcg_reset_dirty_tlb_t tcg_reset_dirty_tlb;
     uc_invalidate_tb_t uc_invalidate_tb;
     uc_gen_tb_t uc_gen_tb;
     uc_tb_flush_t tb_flush;
diff --git a/qemu/unicorn_common.h b/qemu/unicorn_common.h
index 6bcfd32ea6..920b0f0c2e 100644
--- a/qemu/unicorn_common.h
+++ b/qemu/unicorn_common.h
@@ -12,6 +12,7 @@
 
 void vm_start(struct uc_struct*);
 void tcg_exec_init(struct uc_struct *uc, uint32_t tb_size);
+void tlb_reset_dirty(CPUState *cpu, ram_addr_t start1, ram_addr_t length);
 bool unicorn_fill_tlb(CPUState *cs, vaddr address, int size,
                       MMUAccessType rw, int mmu_idx,
                       bool probe, uintptr_t retaddr);
@@ -184,6 +185,17 @@ MemoryRegion *find_memory_mapping(struct uc_struct *uc, hwaddr address)
     return mr;
 }
 
+static void tcg_reset_dirty_tlb(struct uc_struct *uc, MemoryRegion *mr,
+                                uint64_t start, uint64_t len)
+{
+    // The TLB entries are matched by their host address, so this also covers
+    // any virtual address the range is mapped at.
+    uintptr_t host = (uintptr_t)memory_region_get_ram_ptr(mr) +
+                     (start - mr->addr);
+
+    tlb_reset_dirty(uc->cpu, host, len);
+}
+
 void softfloat_init(void);
 static inline void uc_common_init(struct uc_struct* uc)
 {
@@ -203,6 +215,7 @@ static inline void uc_common_init(struct uc_struct* uc)
     uc->target_page = target_page_init;
     uc->softfloat_initialize = softfloat_init;
     uc->tcg_flush_tlb = tcg_flush_softmmu_tlb;
+    uc->tcg_reset_dirty_tlb = tcg_reset_dirty_tlb;
     uc->memory_map_io = memory_map_io;
     uc->set_tlb = uc_set_tlb;
     uc->memory_mapping = find_memory_mapping;
diff --git a/uc.c b/uc.c
index e0faa91dcd..031426385e 100644
--- a/uc.c
+++ b/uc.c
@@ -1732,6 +1732,7 @@ uc_err uc_mem_protect(struct uc_struct *uc, uint64_t address, uint64_t size,
     uint64_t pc;
     uint64_t count, len;
     bool remove_exec = false;
+    bool add_exec;
 
     UC_INIT(uc);
 
@@ -1792,9 +1793,20 @@ uc_err uc_mem_protect(struct uc_struct *uc, uint64_t address, uint64_t size,
                 ((perms & UC_PROT_EXEC) == 0)) {
                 remove_exec = true;
             }
+            add_exec = ((mr->perms & UC_PROT_EXEC) == 0) &&
+                       ((perms & UC_PROT_EXEC) != 0);
             mr->perms = perms;
             uc->readonly_mem(mr, (perms & UC_PROT_WRITE) == 0);
 
+            // TLB_NOTDIRTY is only set on write entries of executable pages
+            // when the TLB is filled, so set it on the entries filled before.
+            // Otherwise writes through them would not invalidate the TBs
+            // translated from this range.  Unlike a TLB flush, this keeps the
+            // entries valid, so it is safe to do from within memory hooks.
+            if (add_exec) {
+                uc->tcg_reset_dirty_tlb(uc, mr, addr, len);
+            }
+
         } else {
             if (!split_mmio_region(uc, mr, addr, len, false)) {
                 restore_jit_state(uc);
